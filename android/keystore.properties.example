# Android release signing configuration (template).
#
# Copy this file to android/keystore.properties and fill in your own values.
# android/keystore.properties is git-ignored and must never be committed.
#
# Each value can alternatively be supplied as a Gradle property
# (for example in ~/.gradle/gradle.properties, or with -PNAME=value) or as an
# environment variable with the same name, which is the recommended approach for CI.
#
# If any value is missing, release builds are signed with the public debug key
# (android/app/debug.keystore). That is fine for testing but must not be published.

# Path to your upload keystore. Relative paths are resolved from android/app/.
# Keep the keystore outside the repository or in a git-ignored location.
CINEVERSE_UPLOAD_STORE_FILE=/absolute/path/to/your-upload-key.keystore
CINEVERSE_UPLOAD_STORE_PASSWORD=change-me
CINEVERSE_UPLOAD_KEY_ALIAS=your-key-alias
CINEVERSE_UPLOAD_KEY_PASSWORD=change-me
